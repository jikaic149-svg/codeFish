# macOS archive metadata
.DS_Store
._*
__MACOSX/

# Local IDE settings
.idea/
.vscode/*
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/robofish-ota.ps1
!.vscode/launch.json

# Local ESP-IDF work files and timestamped OTA exports
RoboFishPartnerDriverSDK/sdkconfig
RoboFishPartnerDriverSDK/build/idf/
RoboFishPartnerDriverSDK/build/*-idf/
RoboFishPartnerDriverSDK/build/RoboFishPartnerDriverSDK-OTA-*.bin
RoboFishPartnerDriverSDK/managed_components/

# Temporary files
*.tmp
*.log
.codex_camera_probe.jpg
.codex_tmp/
output/

# Local Python/YOLO environments and generated caches
.env
**/.env
.venv/
**/.venv/
__pycache__/
**/__pycache__/
*.py[cod]
**/.matplotlib/
**/.ultralytics/
Ultralytics/
VISION/Ultralytics/
VISION/marker_profile.local.json
VISION/head_color_profile.local.json
VISION/.marker_profile.test.json
VISION/turn_calibration.local.json
VISION/pool_calibration.local.json
VISION/configs/*.local.json

# Local vision recordings, datasets, model artifacts, and training outputs
VISION/auv_data_*.csv
VISION/auv_record_*.mp4
VISION/data/
VISION/models/
VISION/training/**/dataset*/
VISION/training/**/seed_dataset/
VISION/training/**/review/
VISION/training/**/runs/

# Local reverse-engineering tool environment
reverse_analysis/.tools/

# Rizin project databases embed workstation-specific absolute paths
reverse_analysis/disassembly/*.rzdb
